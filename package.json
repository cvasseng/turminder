{
  "name": "turminder",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight, self-hosted, LLM-driven personal assistant",
  "author": "Christer Vasseng <hello@vasseng.com>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "turminder": "./dist/src/index.js",
    "turminder-daemon": "./dist/daemon/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/prompts dist/src/model && cp -R src/prompts/library dist/src/prompts/ && cp -R src/model/fixtures dist/src/model/",
    "build:extensions": "node extension/build.mjs",
    "dev": "node dev.mjs",
    "turminder": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "daemon": "tsx daemon/bin.ts",
    "app:dev": "cd app && nix-shell --run 'cargo tauri dev'",
    "app:build": "cd app && nix-shell --run 'cargo tauri build'"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.33",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^1.3.0",
    "@types/ws": "^8.18.1",
    "ai": "^7.0.71",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "docx2js": "^0.1.0-alpha.5",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.10",
    "pdfjs-dist": "^6.2.108",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "reveal.js": "^6.0.1",
    "rrule": "^2.8.1",
    "sqlite-vec": "^0.1.9",
    "ulid": "^3.0.2",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
